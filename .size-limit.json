[
  {
    "name": "首屏 JS（React + 網站本體）",
    "path": "dist/assets/index-*.js",
    "limit": "120 KB",
    "gzip": true
  },
  {
    "name": "3D 核心（three + r3f + drei，場景 lazy 載入）",
    "path": ["dist/assets/three-*.js", "dist/assets/r3f-*.js"],
    "limit": "250 KB",
    "gzip": true
  },
  {
    "name": "場景程式本體",
    "path": "dist/assets/SceneRoot-*.js",
    "limit": "24 KB",
    "gzip": true
  },
  {
    "name": "模型解碼器（GLTFLoader + meshopt，第一次要模型時才載入）",
    "path": "dist/assets/gltf-*.js",
    "limit": "40 KB",
    "gzip": true
  },
  {
    "name": "後製（tier ≥ 2 才載入）",
    "path": ["dist/assets/postfx-*.js", "dist/assets/Effects-*.js"],
    "limit": "80 KB",
    "gzip": true
  },
  {
    "name": "動態套件（GSAP + Lenis，首屏後載入）",
    "path": "dist/assets/motion-impl-*.js",
    "limit": "60 KB",
    "gzip": true
  },
  {
    "name": "全部 JS（不含 ?debug 才載入的效能面板）",
    "path": ["dist/assets/*.js", "!dist/assets/Debug-*.js"],
    "limit": "500 KB",
    "gzip": true
  },
  {
    "name": "CSS",
    "path": "dist/assets/*.css",
    "limit": "15 KB",
    "gzip": true
  },
  {
    "name": "模型（meshopt GLB，依段落鄰近才載入）",
    "path": "dist/models/*.glb",
    "limit": "800 KB",
    "gzip": false,
    "brotli": false
  },
  {
    "name": "字體",
    "path": "dist/fonts/*.woff2",
    "limit": "300 KB",
    "gzip": false,
    "brotli": false
  },
  {
    "name": "圖片（所有格式合計）",
    "path": "dist/assets/*.{avif,webp,jpg,png}",
    "limit": "1500 KB",
    "gzip": false,
    "brotli": false
  }
]
