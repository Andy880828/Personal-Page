{
  "name": "personal-page",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "size": "size-limit && node scripts/check-assets.mjs",
    "analyze": "vite-bundle-visualizer",
    "lhci": "node scripts/lhci.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "images": "node scripts/prepare-images.mjs",
    "og": "node scripts/make-og.mjs",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build && npm run size"
  },
  "dependencies": {
    "@emailjs/browser": "5.0.3",
    "@paper-design/shaders-react": "0.0.82",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.66.0",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@react-three/test-renderer": "9.1.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "r3f-perf": "7.2.3",
    "sharp": "0.35.5",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-bundle-visualizer": "1.2.1",
    "vite-imagetools": "12.0.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
